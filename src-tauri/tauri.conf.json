{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudflare Tunnel Launcher",
  "version": "1.0.0",
  "identifier": "com.cftunnel.gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cloudflare Tunnel Launcher",
        "width": 1000,
        "height": 700,
        "minWidth": 850,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
